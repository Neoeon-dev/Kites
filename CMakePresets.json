
{
    "version": 6,

    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",

            "environment": {
                "PATH": "/usr/lib64/qt6/bin:$penv{PATH}"
            },

            "cacheVariables": {
                "Qt6_DIR": "/usr/lib64/cmake/Qt6",

                "CMAKE_C_COMPILER": "/usr/bin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",

                "CMAKE_FIND_USE_PACKAGE_REGISTRY": "OFF",
                "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": "OFF"
            }
        },

        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "OFF"
            }
        },

        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTS": "OFF"
            }
        },

        {
            "name": "test",
            "displayName": "Test",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "ON",
                "ENABLE_COVERAGE": "OFF",
                "LOG_PANEL": "OFF",
                "DISABLE_GUI": "ON",
                "FETCHCONTENT_BASE_DIR": "${sourceDir}/.cmake-deps"
            }
        },

        {
            "name": "coverage",
            "displayName": "Test Coverage",
            "inherits": "test",
            "cacheVariables": {
                "ENABLE_COVERAGE": "ON"
            }
        },

        {
            "name": "cli",
            "displayName": "CLI",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTS": "OFF",
                "LOG_PANEL": "OFF",
                "DISABLE_GUI": "ON"
            }
        }
    ],

    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },

        {
            "name": "release",
            "configurePreset": "release"
        },

        {
            "name": "cli",
            "displayName": "Build CLI",
            "configurePreset": "cli",
            "targets": ["kites_cli"]
        },

        {
            "name": "test",
            "configurePreset": "test",
            "targets": ["kites_test"]
        },

        {
            "name": "test-only",
            "displayName": "Build tests (no coverage)",
            "configurePreset": "test",
            "targets": ["kites_test"]
        },

        {
            "name": "test-coverage",
            "displayName": "Build tests (with coverage)",
            "configurePreset": "coverage",
            "targets": ["kites_test_cov"]
        }
    ],

    "testPresets": [
        {
            "name": "test",
            "configurePreset": "test",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "exclude": {
                    "name": "^cov_"
                }
            }
        },

        {
            "name": "test-only",
            "displayName": "Run tests (no coverage)",
            "configurePreset": "test",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "exclude": {
                    "name": "^cov_"
                }
            }
        },

        {
            "name": "test-coverage",
            "displayName": "Run tests (with coverage)",
            "configurePreset": "coverage",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "include": {
                    "name": "^cov_"
                }
            }
        }
    ]
}
